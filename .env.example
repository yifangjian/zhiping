# 知平 zhiping — 環境變數範本
#
# 複製成 .env 後填入實際值:cp .env.example .env
# .env 已被 .gitignore 排除,絕對不要 commit。

# --- LINE Messaging API ---
# LINE Developers Console > Messaging API 頻道
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- OpenAI ---
OPENAI_API_KEY=
# 對話用模型(要兼顧語感與速度,總回應時間預算 < 10s)
OPENAI_CHAT_MODEL=gpt-4.1
# 對話回覆的 token 上限(弱網路環境要短回覆)
OPENAI_CHAT_MAX_TOKENS=500

# --- Supabase ---
# 專案 URL,例如 https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# service role key / secret key(後端專用,擁有繞過 RLS 的權限,絕不可外流或放進前端)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres 直連字串,只有跑 migration 時用得到,應用程式不會讀它。
# Supabase 儀表板上方的 Connect → Session pooler → URI
DATABASE_URL=

# --- 維運 ---
# 專案擁有者的 LINE user id,用於接收錯誤通知與額度警告。
# 取得方式:把這個官方帳號加為好友後傳一則訊息,再從 conversations 表撈出 line_user_id。
# 沒設定的話通知會被略過(只留日誌),系統其他功能不受影響。
OWNER_LINE_USER_ID=
# 日誌等級:DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 驗收用:人為延遲回覆秒數,用來實測 reply token 過期後的 push 備援(見 5.7)。
# 正式環境務必保持 0 或留空。
DEBUG_REPLY_DELAY_SECONDS=0

# --- 以下為後續 Phase 會用到,現在可留空 ---
# 記憶抽取用的較便宜模型(Phase 5)
OPENAI_EXTRACT_MODEL=gpt-4.1-mini
# 備份輸出目錄,必須在專案資料夾之外(Phase 7)
BACKUP_DIR=~/zhiping-backups
